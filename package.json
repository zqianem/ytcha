{
  "name": "ytcha",
  "version": "1.0.0",
  "description": "CLI that lists the latest videos from a YouTube channel",
  "exports": "./dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "deno run --allow-all ./index.ts",
    "install": "deno compile --allow-all --output $HOME/.local/bin/ytcha ./index.ts"
  },
  "keywords": ["youtube", "channel", "videos", "list"],
  "author": "Em Zhan",
  "license": "MIT",
  "packageManager": "bun",
  "dependencies": {
    "commander": "^12.1.0",
    "puppeteer": "^23.0.1",
    "which": "^4.0.0"
  },
  "devDependencies": {
    "@types/which": "^3.0.4",
    "typescript": "^5.5.4"
  }
}
